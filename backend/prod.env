APP_NAME=EasyReservation
NODE_ENV=production
APP_DEBUG=false
ADMIN_DEFAULT_PASSWORD=admin
LOG_CHANNEL=stderr

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
CACHE_DRIVER=redis
CACHE_STORE=redis

REDIS_CACHE_DB=1
REDIS_QUEUE=work
REDIS_QUEUE_DB=2
REDIS_CLIENT=predis
REDIS_DB=1
REDIS_PREFIX=

BCRYPT_ROUNDS=12

WORKERSTATUS_DRIVER=redis
WORKERSTATUS_TTL=300
WORKERSTATUS_REDIS_CONNECTION=default
WORKERSTATUS_REDIS_DB=1